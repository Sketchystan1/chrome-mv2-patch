// Labels shown in the DLL's Windows Properties; they identify this independent project.
// CMakeLists.txt supplies the version below during normal builds.
#include <windows.h>

#ifndef MV2_VERC
#define MV2_VERC 2,0,0,0
#endif
#ifndef MV2_VER_STR
#define MV2_VER_STR "2.0.0.0"
#endif
#ifndef MV2_PROD
#define MV2_PROD "2.0.0"
#endif
#ifndef MV2_PROXY_STR
#define MV2_PROXY_STR "secur32.dll"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MV2_VERC
 PRODUCTVERSION MV2_VERC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "chrome-mv2-patch"
            VALUE "FileDescription",  "chrome-mv2-patch " MV2_PROXY_STR " proxy"
            VALUE "FileVersion",      MV2_VER_STR
            VALUE "InternalName",     MV2_PROXY_STR
            VALUE "LegalCopyright",   "Copyright (C) 2026 chrome-mv2-patch. MIT-licensed. Not affiliated with Microsoft or Google."
            VALUE "OriginalFilename", MV2_PROXY_STR
            VALUE "ProductName",      "chrome-mv2-patch mem-patch"
            VALUE "ProductVersion",   MV2_PROD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
